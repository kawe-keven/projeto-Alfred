# Configuração do Alfred
ALFRED_MODELO=qwen3.5:4b
ALFRED_OLLAMA_URL=http://localhost:11434
ALFRED_MODELO_EMBEDDINGS=qwen3-embedding:0.6b
ALFRED_EMBEDDINGS_LOTE=32
# Mantém embeddings na CPU para não disputar a GPU com o modelo de conversa.
ALFRED_EMBEDDINGS_NUM_GPU=0
ALFRED_EMBEDDINGS_THREADS=4
ALFRED_EMBEDDINGS_KEEP_ALIVE=1m
ALFRED_PASTA_PERFIL=dados/perfil
ALFRED_PASTA_ARQUIVOS=dados/arquivos
ALFRED_ARQUIVOS_LIMITE_ARQUIVOS=200
ALFRED_ARQUIVOS_LIMITE_BYTES=20971520
ALFRED_ARQUIVO_LIMITE_BYTES=1000000
ALFRED_PASTA_PESSOAS=dados/perfil/pessoas
ALFRED_PESSOAS_LIMITE_TOTAL=100
ALFRED_PESSOA_LIMITE_PALAVRAS=400
ALFRED_JANELA_MENSAGENS=20
ALFRED_TEMPO_LIMITE_S=120
ALFRED_VOZ_MODO=apertar
ALFRED_PALAVRA_ATIVACAO=Alfred
# OpenWakeWord provisório detecta "hey_jarvis"; isso não é um modelo de "Alfred".
ALFRED_MODELO_ATIVACAO=hey_jarvis
ALFRED_VOZ_HISTORICO=6
ALFRED_VOZ_OLLAMA_KEEP_ALIVE=2m
ALFRED_VOZ_NUM_CTX=4096
ALFRED_VOZ_NUM_PREDICT=96
ALFRED_VAD_LIMIAR_INICIO=0.5
ALFRED_VAD_LIMIAR_FIM=0.35
ALFRED_VAD_SILENCIO_COMPLETO_MS=600
ALFRED_VAD_SILENCIO_HESITACAO_MS=800
ALFRED_VAD_LIMIAR_INTERRUPCAO=0.8
ALFRED_VAD_INTERRUPCAO_MINIMA_MS=120
# Parakeet TDT v3 (multilíngue, local via sherpa-onnx); alternativa: faster-whisper
ALFRED_STT_ENGINE=parakeet
ALFRED_STT_MODELO=nvidia/parakeet-tdt-0.6b-v3
ALFRED_STT_DISPOSITIVO=cpu
ALFRED_STT_COMPUTE_TYPE=int8
ALFRED_STT_PERFIL=equilibrado
# Vocabulário auxiliar aceito pelo backend faster-whisper.
ALFRED_STT_VOCABULARIO=
ALFRED_PIPER_MODELO=dados/modelos/pt_BR-faber-medium.onnx
ALFRED_PIPER_LENGTH_SCALE=1.25
# Perfil de voz de Alfred criado a partir da referência fornecida.
ALFRED_TTS_MOTOR=voicestudio
ALFRED_VOICESTUDIO_URL=http://127.0.0.1:3900/v1
ALFRED_VOICESTUDIO_MOTOR=omnivoice
ALFRED_VOICESTUDIO_VOZ=66b001cc
ALFRED_VOICESTUDIO_FORMAT=pcm
ALFRED_VOICESTUDIO_TAXA=24000
ALFRED_VOICESTUDIO_TIMEOUT_CONEXAO=3
ALFRED_VOICESTUDIO_TIMEOUT_LEITURA=30
# Em caso de falha do VoiceStudio, usa Piper Faber (voz parecida, não idêntica).
ALFRED_TTS_FALLBACK=piper
ALFRED_VOICESTUDIO_ESTILO="Fale em português brasileiro com ritmo de conversa espontânea: entonação sutilmente variada, pausas breves entre ideias e um tom caloroso e tranquilo. Evite soar como locução, leitura de texto ou anúncio, sem exagerar emoções. Mantenha o mesmo timbre. Pronuncie termos técnicos comuns em inglês naturalmente, sem trocar de idioma."
ALFRED_BARGE_IN_PALAVRA=false
# ALFRED_DEBUG=false
