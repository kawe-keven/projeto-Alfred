# Alfred AI — Environment Variables
# Copie este arquivo para .env e preencha os valores

# LLM Provider — escolha: gemini | ollama | openai
LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.0-flash-lite
TEMPERATURE=0.7
MAX_TOKENS=1000

# Google Gemini — Free Tier (15 RPM / 1 500 req/dia)
# Obtenha sua chave gratuita em: https://aistudio.google.com
GEMINI_API_KEY=AIzaSyCJ07RcWhCpUG-tzlewXS5mf9LwbhF8SD8

# Groq — Free Tier (~14 400 req/dia | llama 3.3 70B ultrarrápido)
# Obtenha sua chave gratuita em: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — 50+ modelos gratuitos (llama, gemini-exp, mistral...)
# Obtenha sua chave gratuita em: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — Modelos Locais (offline, 100%% gratuito)
# Instale em: https://ollama.ai  |  execute: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# Descomente abaixo para usar Ollama e comente as linhas Gemini:
# LLM_PROVIDER=ollama
# MODEL_NAME=llama3.2

# OpenAI — Legado (pago)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# MODEL_NAME=gpt-3.5-turbo

# Memória SQLite (curto prazo)
MEMORY_DB_PATH=memory/alfred_memory.db

# Memória Vetorial (longo prazo — ChromaDB)
VECTOR_DB_PATH=memory/vector_db
VECTOR_COLLECTION_NAME=alfred_memory
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_TOP_K=3

# Integração Externa — Clima (OpenWeatherMap)
# Obtenha sua chave gratuita em: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=6e3dc170d582c0eb72447839e40db186
WEATHER_CITY=Aracaju
# Multi-cidade (JSON array) — separa os cards no widget da Sidebar
WEATHER_CITIES=["Aracaju", "Laranjeiras"]

# Calendário local
CALENDAR_PATH=data/calendar.json

# DevAgent — repositório monitorado pelo Alfred
# Deixe em branco para usar o diretório atual (CWD)
PROJECT_PATH=C:/Users/keven/Downloads/projeto alfred
PROJECT_NAME=alfred
